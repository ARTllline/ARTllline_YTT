{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "YTT controlled SRD 2024 manifest (adapters v4/v5)",
  "type": "object",
  "required": [
    "format",
    "adapter_version",
    "source",
    "ruleset",
    "export",
    "selection",
    "reviews"
  ],
  "properties": {
    "format": {
      "const": 1
    },
    "adapter_version": {
      "enum": [4, 5]
    },
    "source": {
      "const": "srd-2024"
    },
    "ruleset": {
      "const": "dnd-2024"
    },
    "export": {
      "type": "object",
      "required": [
        "srd_commit",
        "library_version"
      ],
      "properties": {
        "srd_commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "library_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      }
    },
    "selection": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "entity_type",
          "external_key",
          "checksum"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^srd:(equipment|magic_item|spell):[a-z0-9][a-z0-9-]*(?:\\([a-z0-9-]+\\))?:2024$"
          },
          "kind": {
            "enum": [
              "equipment",
              "magic_item",
              "spell"
            ]
          },
          "entity_type": {
            "enum": [
              "items",
              "weapons",
              "armor",
              "spells"
            ]
          },
          "external_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "checksum": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "content_checksum": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "correction": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "evidence",
              "fields"
            ],
            "properties": {
              "evidence": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "fields": {
                "type": "object",
                "additionalProperties": false,
                "minProperties": 1,
                "properties": {
                  "name_ru": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 255
                  },
                  "description_en": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 60000
                  },
                  "description_ru": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 60000
                  }
                }
              }
            }
          }
        },
        "dependentRequired": {
          "correction": [
            "content_checksum"
          ]
        }
      }
    },
    "reviews": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "id",
          "checksum",
          "reviewer",
          "evidence",
          "browse",
          "copy",
          "execute",
          "confirmed",
          "confirmed_at",
          "languages",
          "projection_checksum"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "checksum": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "reviewer": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "browse": {
            "type": "boolean"
          },
          "copy": {
            "type": "boolean"
          },
          "execute": {
            "type": "boolean"
          },
          "confirmed": {
            "const": true
          },
          "confirmed_at": {
            "type": "string",
            "format": "date-time"
          },
          "languages": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "uniqueItems": true,
            "items": {
              "enum": [
                "en",
                "ru"
              ]
            }
          },
          "projection_checksum": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "execution_checksum": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "execute": {
                  "const": true
                }
              },
              "required": [
                "execute"
              ]
            },
            "then": {
              "required": [
                "execution_checksum"
              ],
              "properties": {
                "copy": {
                  "const": true
                }
              }
            }
          }
        ]
      }
    },
    "baseline_reviews": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "policy",
          "entry_id",
          "baseline_digest",
          "confirmed",
          "confirmed_at",
          "reviewer",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^srd:equipment:[a-z0-9][a-z0-9-]*(?:\\([a-z0-9-]+\\))?:2024$"
          },
          "policy": {
            "enum": ["legacy-equipment-missing-null-ammunition-v1", "legacy-equipment-missing-source-ammunition-v1"]
          },
          "entry_id": {
            "type": "integer",
            "minimum": 1
          },
          "baseline_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "confirmed": {
            "const": true
          },
          "confirmed_at": {
            "type": "string",
            "format": "date-time"
          },
          "reviewer": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      }
    }
  },
  "$comment": "Runtime additionally validates unique IDs/identities, index/detail correspondence, local review membership, exact checksums, paths, links, images and numeric semantics. This schema is not an import permission."
}
