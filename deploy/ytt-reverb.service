[Unit]
Description=YTT Reverb
After=network.target redis-server.service
[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/srv/ytt/current
ExecStart=/usr/bin/php artisan reverb:start --host=127.0.0.1 --port=8080
Restart=always
RestartSec=3
TimeoutStopSec=30
UMask=0027
NoNewPrivileges=true
[Install]
WantedBy=multi-user.target
