<?xml version="1.0" encoding="utf-8"?>
<WindowsPerformanceRecorder Version="1.0" Author="YTT">
  <Profiles>
    <SystemCollector Id="ReceiptCollector" Name="YTT receipt waits">
      <BufferSize Value="1024" />
      <Buffers Value="128" />
    </SystemCollector>
    <SystemProvider Id="ReceiptProvider">
      <Keywords>
        <Keyword Value="ProcessThread" />
        <Keyword Value="CSwitch" />
        <Keyword Value="ReadyThread" />
        <Keyword Value="DiskIO" />
        <Keyword Value="DiskIOInit" />
      </Keywords>
    </SystemProvider>
    <Profile Id="Receipt.Light.Memory" Name="Receipt" Description="MySQL receipt thread waits and disk IO" LoggingMode="Memory" DetailLevel="Light">
      <Collectors>
        <SystemCollectorId Value="ReceiptCollector"><SystemProviderId Value="ReceiptProvider" /></SystemCollectorId>
      </Collectors>
    </Profile>
  </Profiles>
</WindowsPerformanceRecorder>
